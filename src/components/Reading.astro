---
import type { ReadingLink } from "../lib/reading";

interface Props {
  links: ReadingLink[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <aside class="reading">
      <h2>Further reading</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
            <span>{link.source}</span>
          </li>
        ))}
      </ul>
    </aside>
  )
}
