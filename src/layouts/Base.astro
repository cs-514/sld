---
import "../styles/site.css";
import SearchForm from "../components/SearchForm.astro";
import { href } from "../lib/paths";
import { SITE_NAME } from "../lib/site";

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  canonicalPath?: string;
  noindex?: boolean;
  hideHeaderSearch?: boolean;
}

const { title, description, crumbs = [], canonicalPath, noindex = false, hideHeaderSearch = false } = Astro.props;
const canonical = new URL(canonicalPath ? href(canonicalPath) : Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = (prefix: string) => {
  const target = href(prefix);
  const normal = target.endsWith("/") ? target : `${target}/`;
  if (!prefix) return path === normal;
  return path === normal || path.startsWith(normal);
};
const onHome = current("");
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
const markLines = SITE_NAME.split(/ (?=[^ ]+$)/);
const nav = [
  ["", "Home", "Home"],
  ["33-act/", "Securities Act", "1933"],
  ["34-act/", "Exchange Act", "1934"],
  ["tia/", "Trust Indenture Act", "TIA"],
  ["rules/", "Rules", "Rules"],
  ["forms/", "Forms", "Forms"],
  ["edgar/", "EDGAR", "EDGAR"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#1c4a3c" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex" />}
    {noindex && <meta data-pagefind-ignore="all" />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content" data-pagefind-ignore>Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="wrap header-row">
        <a class="mark" href={href()}>
          <span class="sigil" aria-hidden="true">§</span>
          <span class="mark-name">
            {markLines.map((line) => <span class="mark-line">{line}</span>)}
          </span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          {
            nav.map(([to, label, short]) => (
              <a href={href(to)} aria-current={current(to) ? "page" : undefined}>
                <span class="nav-full">{label}</span>
                <span class="nav-short">{short}</span>
              </a>
            ))
          }
        </nav>
        {!hideHeaderSearch && <SearchForm />}
        <button type="button" id="theme" class="theme">Dark</button>
      </div>
    </header>
    <main id="content" data-pagefind-body>
      <div class="wrap">
        {
          (onHome || crumbs.length > 0) && (
            <nav class="crumbs" aria-label="Breadcrumb">
              {onHome ? <span>Home</span> : <a href={href()}>Home</a>}
              {crumbs.map((crumb) => (
                <span>
                  <span aria-hidden="true"> / </span>
                  {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
                </span>
              ))}
            </nav>
          )
        }
        <slot />
      </div>
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <span>Statutes from the House OLRC. Rules from the eCFR. Filings are an EDGAR snapshot, not a live feed.</span>
        <span><a href={href("sources/")}>Sources and currency</a></span>
      </div>
    </footer>
    <nav class="bottom-nav" aria-label="Primary" data-pagefind-ignore>
      {
        nav.map(([to, , short]) => (
          <a href={href(to)} aria-current={current(to) ? "page" : undefined}>
            {short}
          </a>
        ))
      }
    </nav>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
