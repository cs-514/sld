---
import Redirect from "../../components/Redirect.astro";
import { loadAct } from "../../lib/statutes";

export function getStaticPaths() {
  return [
    ["33-act", "securities-act"],
    ["34-act", "exchange-act"],
  ].flatMap(([act, dest]) =>
    loadAct(act).sections.map((section) => ({
      params: { act, slug: section.slug },
      props: { to: `${dest}/${section.slug}/` },
    })),
  );
}

const { to } = Astro.props;
---

<Redirect to={to} />
