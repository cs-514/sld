---
import Redirect from "../../components/Redirect.astro";

export function getStaticPaths() {
  return [
    { params: { act: "33-act" }, props: { to: "securities-act/" } },
    { params: { act: "34-act" }, props: { to: "exchange-act/" } },
  ];
}

const { to } = Astro.props;
---

<Redirect to={to} />
