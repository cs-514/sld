---
import Base from "../layouts/Base.astro";
import SearchForm from "../components/SearchForm.astro";
import { href } from "../lib/paths";
import { SITE_NAME } from "../lib/site";
import { findSection, loadActs, loadProvenance, PINS } from "../lib/statutes";

const acts = loadActs();
const provenance = loadProvenance();
const pins = PINS.map((pin) => {
  const file = acts.find((item) => item.act.id === pin.act);
  const section = file && findSection(pin.act, pin.slug);
  return { pin, file, section };
}).filter((item) => item.section && item.file);
const description =
  "Read the Securities Act, the Exchange Act, and the Trust Indenture Act, and look up a company’s recent EDGAR filings.";
const soon = ["Rules and Regulations", "Forms", "SEC Releases", "Staff interpretations (C&DIs)"];
---

<Base title="Home" description={description} hideHeaderSearch>
  <p class="kicker">Securities Act · Exchange Act · Trust Indenture Act · EDGAR</p>
  <h1>{SITE_NAME}</h1>
  <p class="lede">
    Read a section of the Securities Act, the Exchange Act, or the Trust Indenture Act, or look up a company’s EDGAR filings.
  </p>
  <SearchForm prominent />

  <div class="cards">
    {
      acts.map((file) => (
        <a class="card" href={href(file.act.path)}>
          <strong>{file.act.shortName}</strong>
          <span>{file.act.scope}</span>
          <em>
            {file.sections.length} sections · 15 U.S.C. ch. {file.act.chapter}
          </em>
        </a>
      ))
    }
    <a class="card" href={href("edgar/")}>
      <strong>EDGAR company search</strong>
      <span>Search by name or ticker. Open a snapshot of recent filings, or the live EDGAR index.</span>
      <em>AAPL · MSFT · JPM</em>
    </a>
  </div>

  <h2>Coming soon</h2>
  <ul class="soon">
    {soon.map((label) => (
      <li>
        <span>{label}</span>
        <span class="tag">Coming soon</span>
      </li>
    ))}
  </ul>

  <h2>Often opened</h2>
  <div class="pins">
    {
      pins.map(({ pin, file, section }) => (
        <a class="pin" href={`${href(section!.path)}${pin.hash ? `#${pin.hash}` : ""}`}>
          <b>
            {file!.act.titleName} {pin.hash ? `${section!.label}(${pin.hash})` : section!.label}
          </b>
          <span>
            {section!.heading}
            <small>
              {section!.uscCite} · {pin.note}
            </small>
          </span>
        </a>
      ))
    }
  </div>

  <p class="note">
    Text from the House Office of the Law Revision Counsel, {provenance.release.docPublicationName},{" "}
    {provenance.release.currencyNote.toLowerCase()}. Title 15 is not positive law. The Act section number comes from the source credit.
  </p>
</Base>
