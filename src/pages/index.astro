---
import Base from "../layouts/Base.astro";
import SearchForm from "../components/SearchForm.astro";
import { HALVES } from "../lib/desk";
import { href } from "../lib/paths";
import { SITE_NAME } from "../lib/site";
import { taskPath, tasksFor } from "../lib/tasks";

const description =
  "A desk for public-company and capital-markets work. Securities Act offerings on one side, Exchange Act reporting on the other, plus EDGAR.";
const columns = HALVES.map((half) => ({
  half,
  tasks: tasksFor(half.id).map((task) => ({
    task,
    hint: task.title.match(/\(([^)]+)\)/)?.[1] || task.nav,
  })),
}));
---

<Base title="Home" description={description} hideHeaderSearch>
  <p class="kicker">Public companies · Capital markets</p>
  <h1>{SITE_NAME}</h1>
  <p class="lede">
    Two halves. The Securities Act covers how securities are offered, exempted, and resold. The Exchange Act covers how a public company reports, solicits proxies, and runs its disclosure. Foreign private issuers are in both.
  </p>
  <SearchForm prominent />

  <div class="halves">
    {
      columns.map(({ half, tasks }) => (
        <section class="half">
          <h2>
            <a href={href(`${half.id}/`)}>{half.label}</a>
          </h2>
          <p>{half.blurb}</p>
          <ul class="task-list">
            {tasks.map(({ task, hint }) => (
              <li>
                <a href={href(taskPath(task))}>
                  <strong>{task.nav}</strong>
                  <span>{hint}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="link-row home-more">
    <a href={href("edgar/")}>EDGAR company search</a>
    <a href={href("forms/")}>Forms</a>
    <a href={href("sources/")}>Sources and currency</a>
  </p>
</Base>
