---
import Redirect from "../../../components/Redirect.astro";
import { halfForPart } from "../../../lib/desk";
import { loadManifest, loadPart } from "../../../lib/rules";

export function getStaticPaths() {
  const paths = [];
  for (const part of loadManifest().parts) {
    for (const page of loadPart(part.part).sections) {
      paths.push({
        params: { part: `17-cfr-${part.part}`, slug: page.slug },
        props: { to: `${halfForPart(part.part)}/rules/17-cfr-${part.part}/${page.slug}/` },
      });
    }
  }
  return paths;
}

const { to } = Astro.props;
---

<Redirect to={to} />
