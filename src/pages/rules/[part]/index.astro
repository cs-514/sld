---
import Redirect from "../../../components/Redirect.astro";
import { halfForPart } from "../../../lib/desk";
import { loadManifest } from "../../../lib/rules";

export function getStaticPaths() {
  return loadManifest().parts.map((part) => ({
    params: { part: `17-cfr-${part.part}` },
    props: { to: `${halfForPart(part.part)}/rules/17-cfr-${part.part}/` },
  }));
}

const { to } = Astro.props;
---

<Redirect to={to} />
